FLASK_APP=flask_app.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
# Production runs PostgreSQL. Develop against Postgres too — SQLite accepts
# things Postgres rejects (see "قواعد الـ Migrations" in DEPLOY.md), so a
# migration that passes on SQLite can still break the server.
DATABASE_URL=postgresql://postgres:pg@localhost/yasmin_farm
# Comment the line above to fall back to SQLite at instance/farm.db
SESSION_LIFETIME_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=60

# ---------- المساعد الذكي (DeepSeek) ----------
# مفتاح منفصل لمشروع الياسمين من platform.deepseek.com (سمّيه elyasmin-assistant)
DEEPSEEK_API_KEY=
# ملحوظة: "deepseek-chat" القديم اتشال من قائمة الموديلات يوم 2026-07-24
# (لسه بيرد كـ alias قديم بس مش مضمون يفضل) — استخدم الاسم الجديد
DEEPSEEK_MODEL=deepseek-v4-flash
# سعر المليون توكن بالدولار — راجعهم لو DeepSeek غيّروا التسعير
AI_PRICE_INPUT_PER_M=0.14
AI_PRICE_OUTPUT_PER_M=0.28
# قفل الأمان: لو تكلفة الشهر عدّت الرقم ده، المساعد يوقف نفسه
AI_MONTHLY_BUDGET_USD=5.00

# ---------- SMTP (SEC-1) ----------
# سيب SMTP_HOST فاضي عشان الإيميلات تتسجّل في اللوج بس (وضع التطوير).
# لـ Resend: SMTP_HOST=smtp.resend.com، SMTP_USER=resend،
# SMTP_PASSWORD=<مفتاح Resend API>، والـ from لازم يكون دومين موثّق.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@elyasmin.manasety.ai
SMTP_FROM_NAME=مزرعة الياسمين
SMTP_USE_TLS=true
