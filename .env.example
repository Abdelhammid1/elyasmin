FLASK_APP=flask_app.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
# Production runs PostgreSQL. Develop against Postgres too — SQLite accepts
# things Postgres rejects (see "قواعد الـ Migrations" in DEPLOY.md), so a
# migration that passes on SQLite can still break the server.
DATABASE_URL=postgresql://postgres:pg@localhost/yasmin_farm
# Comment the line above to fall back to SQLite at instance/farm.db
SESSION_LIFETIME_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=60
